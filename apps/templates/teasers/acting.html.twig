<a href="{{ site_path(acting.person) }}" title="{{ acting.person.title|e('html_attr') }}">
    <div class="background spoiler" data-bg="{{ site_asset(acting.person, 'profile') }}">
    </div>
    <div class="wrapper">
        <h2 class="title">
            {{ acting.person.title }}
        </h2>
    </div>
    <div class="wrapper">
        {% if acting.character is defined %}
            <div class="character">
                {{ acting.character }}
            </div>
        {% else %}
            <div class="department">
                {{ acting.department }} {{ acting.job }}
            </div>
        {% endif %}
    </div>
</a>