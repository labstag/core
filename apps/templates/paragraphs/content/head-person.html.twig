{% use "elements.html.twig" %}
{% set movies = casting_movies(person) %}
{% set series = casting_series(person) %}
{% set episodes = casting_episodes(person) %}
<section{% with {attr: paragraph_contextmenu(paragraph)} %}{{ block('attributes') }}{% endwith %}>
	<div class="first">
        <div class="background" style="--image-url: url('{{ site_asset(person, 'profile') }}')"></div>
        <div class="content">
            <div class="wrapper">
                <h3 class="title">
                    {{ person.title }}
                </h3>
                <div class="birthday">
                    {{ 'Date of birth : %date%'|trans({ '%date%': person.birthday|format_date(locale: 'fr_FR', dateFormat: 'full') }) }}
                </div>
                {% if person.deathday %}
                    <div class="deathday">
                        {{ 'Date of death : %date%'|trans({ '%date%': person.deathday|format_date(locale: 'fr_FR', dateFormat: 'full') }) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="second">
        <div class="biography">
            <div class="wrapper">
                {{ person.biography|raw }}
            </div>
        </div>
        {% set totalseries = series['cast']|length+ series['crew']|length %}
        {% set totalmovies = movies['cast']|length + movies['crew']|length %}
        {% set totalepisodes = episodes['cast']|length + episodes['crew']|length %}
        {% if totalseries != 0 or totalmovies != 0 or totalepisodes != 0 %}
            <div class="casting">
                <div class="wrapper">
                    <div class="content">
                        {% if totalmovies != 0 %}
                            <h4>{{ 'Movies'|trans }}</h4>
                            <ul>
                                {% for row in movies['cast']|merge(movies['crew']) %}
                                    <li class="teaser-movie">
                                        {% include "teasers/movie.html.twig"  with {'movie': row.entity} %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if totalseries != 0 %}
                            <h4>{{ 'Series'|trans }}</h4>
                            <ul>
                                {% for row in series['cast']|merge(series['crew']) %}
                                    <li class="teaser-serie">
                                        {% include "teasers/serie.html.twig"  with {'serie': row.entity} %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if totalepisodes != 0 %}
                            <h4>{{ 'Episodes'|trans }}</h4>
                            <ul>
                                {% for row in episodes['cast']|merge(episodes['crew']) %}
                                    <li class="teaser-episode">
                                        {% include "teasers/episode.html.twig"  with {'episode': row.entity} %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
