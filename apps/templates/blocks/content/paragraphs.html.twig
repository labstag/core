{% use "elements.html.twig" %}
<div{% with {attr: block_contextmenu(block)} %}{{ block('attributes') }}{% endwith %}>
    {% for tab in paragraphs %}
        {% if app.debug %}
            {{ debug_begin(tab) }}
        {% endif %}
        {{ paragraph_show(tab) }}
        {% if app.debug %}
            {{ debug_end(tab) }}
        {% endif %}
    {% endfor %}
</div>