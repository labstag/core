{% use "elements.html.twig" %}
<div{% with {attr: block_contextmenu(block)} %}{{ block('attributes') }}{% endwith %}>
    <section>
        {% for tab in paragraphs %}
            {% if app.debug %}
                {{ debug_begin(tab) }}
            {% endif %}
            {{ paragraph_show(tab) }}
            {% if app.debug %}
                {{ debug_end(tab) }}
            {% endif %}
        {% endfor %}
    </section>
    {% if aside is defined %}
        <aside>
            aa
        </aside>
    {% endif %}
</div>