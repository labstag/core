{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{% extends '@EasyAdmin/page/content.html.twig' %}
{% block main %}
    <h3 class="mb-2">{{ 'Statistics'|trans }}</h3>
    <div class="row mb-3 align-items-stretch" id="dashboard-stats">
        {% for label in statLabels|default([]) %}
        {% set ctrl = statControllers[label]|default(null) %}
        <div class="col-md-3 col-sm-6 mb-2"
             data-stat="{{ label }}"
             data-stat-url="{{ path('admin_dashboard_stat', {entity: label|lower}) }}"
             data-index-url="{{ ctrl ? ea_url().setController(ctrl).setAction('index').generateUrl() : '#' }}"
             data-trash-url="{{ ctrl ? ea_url().setController(ctrl).setAction('index').set('action', 'trash').generateUrl() : '' }}">
            <div class="card text-center h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="card-title">{{ label|trans }}</h5>
                    <a href="#" class="stat-index-link text-decoration-none">
                        <p class="card-text display-6 stat-count">…</p>
                    </a>
                    <a href="#" class="stat-trash-link text-muted small" style="display:none;">
                        Corbeille: <span class="stat-trash-count">0</span>
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% for memo in memos %}
        {% include "admin/memo.html.twig" with { 'memo': memo, 'paragraphs': paragraphs } %}
    {% endfor %}
{% endblock %}