{% set instance = entity.instance %}
{% set castings = casting_episodes(instance) %}
{% set total = castings['crew']|length+castings['cast']|length %}
{% if ea().crud.currentAction == 'detail' %}
    {% if total != 0 %}
        {% for id, casting in castings %}
            {% if casting|length != 0 %}
                <h8>{% if id == 'crew' %}{{ 'Crew'|trans }}{% else %}{{ 'Cast'|trans }}{% endif %}</h3>
                <table class="table datagrid">
                    <thead>
                        <tr>
                            <th>{{ 'Episode'|trans }}</th>
                            {% if id == 'crew' %}
                                <th>{{ 'Department'|trans }}</th>
                                <th>{{ 'Job'|trans }}</th>
                            {% else %}
                                <th>{{ 'Character'|trans }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in casting %}
                            <tr>
                                <td>
                                    <a href="{{ admin_url('detail', row.entity) }}">
                                        {{ row.entity.title }}
                                    </a>
                                </td>
                                {% if id == 'crew' %}
                                    <td>{{ row.department }}</td>
                                    <td>{{ row.job }}</td>
                                {% else %}
                                    <td>{{ row.character }}</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endfor %}
    {% else %}
        <p>{{ 'No castings available'|trans }}</p>
    {% endif %}
{% else %}
  {{ castings['crew']|length+castings['cast']|length }}
{% endif %}
