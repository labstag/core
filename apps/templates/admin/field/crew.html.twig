{% set instance = entity.instance %}
{% if ea().crud.currentAction == 'detail' %}
  {% set castings = casting_crew(instance) %}
  <table class="table datagrid">
    {% for casting in castings %}
      <tr>
        <td>
         {% if casting.person is not null %}
          <a href="{{ admin_url('detail', casting.person) }}">
            {{ casting.person.title }}
          </a>
          {% endif %}
        </td>
        <td>{{ casting.department }}</td>
        <td>{{ casting.job }}</td>
      </tr>
    {% endfor %}
  </table>
{% else %}
  {{ instance.castings|length }}
{% endif %}
