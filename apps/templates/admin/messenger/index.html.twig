{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'Messages Messenger'|trans }}{% endblock %}

{% block main %}
<table class="table">
    <thead>
        <tr>
            <th>{{ 'ID'|trans }}</th>
            <th>{{ 'Queue'|trans }}</th>
            <th>{{ 'Body'|trans }}</th>
            <th>{{ 'Created'|trans }}</th>
            <th>{{ 'Available'|trans }}</th>
            <th>{{ 'Delivered'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
    {% for row in rows %}
        <tr>
            <td>{{ row.id }}</td>
            <td>{{ row.queue_name }}</td>
            <td>{{ row.body|slice(0,80) }}</td>
            <td>{{ row.created_at }}</td>
            <td>{{ row.available_at }}</td>
            <td>{{ row.delivered_at }}</td>
            <td>
                <a href="{{ path('admin_messenger_delete', {id: row.id}) }}" class="btn btn-sm btn-danger">{{ 'Delete'|trans }}</a>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}