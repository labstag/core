{
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore: release v${version}"
  },
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "git pull"
    ],
    "after:bump": "npx auto-changelog -p",
    "after:release": "task labstag:docker:image"
  }
}
