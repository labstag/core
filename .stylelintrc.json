{
  "extends": "stylelint-config-standard",
  "rules": {
      "at-rule-no-unknown": [
          true,
          {
            "ignoreAtRules": ["extend", "include", "import", "use", "mixin", "if", "else", "warn", "function", "return"]
        }
      ],
      "selector-class-pattern": null,
      "media-query-no-invalid": null,
      "no-descending-specificity": null
  }
}
